		VALUE "ProductName",      "PuppetPad Virtual Gamepad Emulation Bus Driver"
		VALUE "ProductVersion",	  "1.16.200.0"
        END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409,1200
	END

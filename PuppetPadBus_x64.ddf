; PuppetPadBus cab file for attestation submission
.OPTION EXPLICIT
.Set CabinetFileCountThreshold=0
.Set FolderFileCountThreshold=0
.Set FolderSizeThreshold=0
.Set MaxCabinetSize=0
.Set MaxDiskFileCount=0
.Set MaxDiskSize=0
.Set CompressionType=MSZIP
.Set Cabinet=on
.Set Compress=on
; x64
.Set CabinetNameTemplate=PuppetPadBus_x64.cab
.Set DestinationDir=PuppetPadBus_x64
LICENSE
bin\x64\PuppetPadBus.pdb
bin\x64\PuppetPadBus\PuppetPadBus.inf
bin\x64\PuppetPadBus\PuppetPadBus.sys
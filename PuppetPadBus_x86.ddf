; PuppetPadBus cab file for attestation submission
.OPTION EXPLICIT
.Set CabinetFileCountThreshold=0
.Set FolderFileCountThreshold=0
.Set FolderSizeThreshold=0
.Set MaxCabinetSize=0
.Set MaxDiskFileCount=0
.Set MaxDiskSize=0
.Set CompressionType=MSZIP
.Set Cabinet=on
.Set Compress=on
; x86
.Set CabinetNameTemplate=PuppetPadBus_x86.cab
.Set DestinationDir=PuppetPadBus_x86
LICENSE
bin\x86\PuppetPadBus.pdb
bin\x86\PuppetPadBus\PuppetPadBus.inf
bin\x86\PuppetPadBus\PuppetPadBus.sys